{
  "$comment": "sistem-bekci'nin tek çıktısı. Kanıtsız PASS yok: her kriterin `kanit` alanı komut çıktısı ya da dosya izi olmalı.",
  "type": "object",
  "additionalProperties": false,
  "required": ["increment_id", "motor", "karar", "kriterler", "ihlal", "kapsam_sapmasi"],
  "properties": {
    "increment_id": {"type": "string", "minLength": 1},
    "motor": {"type": "string", "enum": ["codex", "agy", "grok", "claude"],
              "description": "Denetleyen motor — üreten motordan farklı olmak zorunda (ANAYASA §3)."},
    "karar": {"type": "string", "enum": ["PASS", "FAIL"]},
    "kriterler": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["aciklama", "sonuc", "kanit"],
        "properties": {
          "aciklama": {"type": "string", "minLength": 1},
          "sonuc": {"type": "string", "enum": ["PASS", "FAIL"]},
          "kanit": {"type": "string", "minLength": 1,
                    "description": "Çalıştırılan komut + çıkış kodu/çıktı özeti, ya da var olan dosyanın yolu."}
        }
      }
    },
    "ihlal": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kriter", "kanit"],
        "properties": {
          "kriter": {"type": "string", "minLength": 1},
          "kanit": {"type": "string", "minLength": 1}
        }
      }
    },
    "kapsam_sapmasi": {"type": "array", "items": {"type": "string"},
                       "description": "Sözleşme dışında dokunulan yollar. Sürücünün ölçümüyle çelişmemeli."}
  }
}

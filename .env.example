# Kopyala: cp .env.example .env — sonra değerleri doldur. `.env` git'e GİRMEZ.
# Motorlar (claude, agy, codex, grok) kendi oturum/anahtar yönetimini kullanır; buraya anahtar gerekmez.
# Bir takım `gerekli_anahtarlar:` alanında bir değişken isterse burada tanımlanır.

# Motor alanı boş olan takımlar için varsayılan motor (claude | agy | codex | grok)
VARSAYILAN_MOTOR=claude

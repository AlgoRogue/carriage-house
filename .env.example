# Kopyala: cp .env.example .env — sonra değerleri doldur. `.env` git'e GİRMEZ.

# Telegram botu: @BotFather ile bot aç, token'ı buraya yapıştır.
TELEGRAM_BOT_TOKEN=
# Bota bir mesaj at, sonra `python3 bin/telegram_oku.py --chat-id-bul` çalıştır, çıkan sayıyı yaz.
TELEGRAM_CHAT_ID=

# Apify (YouTube verisi): apify.com → Settings → API tokens
APIFY_TOKEN=

# fal (kapak görseli): fal.ai → Keys. Boş bırakılabilir — kapağı sen eklersin.
FAL_KEY=

# Bekçi için ayrı aile (ANAYASA 3). Boş bırakılırsa yedek yol Haiku'dur ve karar
# "bekçi aynı aileden — uyarı" notuyla kaydedilir.
OPENAI_API_KEY=

# İzlenecek YouTube kanalı (youtube-analiz takımı bunu okur)
KANAL=@ornek-kanal
